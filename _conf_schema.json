{
    "if_remove_think_tag": {
        "description": "是否去除<think></think>",
        "type": "bool",
        "hint": "因为思考模型会以<think>...</think>的形式输出思考过程，会影响语音合成，如果不是使用思考模型可忽略",
        "obvious_hint": true
    },
    "if_reduce_parenthesis": {
        "description": "是否提醒llm减少括号中内容生成",
        "type": "bool",
        "hint": "有些人格设置会影响该设置生效，请酌情使用"
    },
    "if_remove_emoji": {
        "description": "是否去除句子里的表情(emoji)",
        "type": "bool"
    },
    "if_split_text": {
        "description": "是否分割句子",
        "type": "bool"
    },
    "use_fp16": {
        "description": "是否使用fp16精度",
        "type": "bool",
        "default": false
    },
    "use_cuda_kernel": {
        "description": "是否使用cuda内核",
        "type": "bool",
        "default": false
    },
    "use_deepspeed": {
        "description": "是否使用deepspeed加速",
        "type": "bool",
        "default": false
    },
    "use_emo_text": {
        "description": "是否使用情感文本",
        "type": "bool",
        "default": false
    },
    "use_random": {
        "description": "是否使用随机",
        "type": "bool",
        "default": false
    },
    "verbose": {
        "description": "是否输出详细日志",
        "type": "bool",
        "default": false
    },
    "generation":{
        "description": "配置",
        "type": "object",
        "items": {
            "prompt_wav":{
                "description": "源音频文件",
                "type": "string",
                "hint": "源语音",
                "default": "prompt_白芷.wav"
            },
            "emo_alpha": {
                "description": "情感alpha参数",
                "type": "float",
                "default": 1.0
            },
            "interval_silence": {
                "description": "静音间隔",
                "type": "int",
                "default": 120
            },
            "emo_audio_prompt": {
                "description": "情感音频提示",
                "type": "string",
                "default": ""
            },
            "emo_text": {
                "description": "情感文本",
                "type": "string",
                "default": ""
            },
            "emo_vector": {
                "description": "情感向量",
                "type": "list",
                "default": [0, 0, 0, 0, 0, 0, 0, 0]
            },
            "model_ver":{
                "description": "模型版本",
                "type": "string",
                "options": ["1","1.5","2"],
                "hint": "模型版本，默认为IndexTTS-1.5版本",
                "default": "1.5"
            },
            "if_preload":{
                "description": "是否预加载模型",
                "type": "bool",
                "default": false
            },
            "max_text_tokens_per_sentence":{
                "description": "每个句子最多的Token数",
                "type": "int",
                "default": 100
            },
            "if_random_tts":{
                "description": "是否开启随机TTS回复",
                "type": "bool",
                "default": false
            },
            "random_factor":{
                "description": "随机因子",
                "hint": "随机因子越大，事件概率越大，也就越容易触发",
                "type": "float",
                "default": 0.3
            },
            "speaking_speed":{
                "description": "语速",
                "hint": "0.5~1.5，默认1.0；需后端支持（indextts2-astrbot-api），原版service.py会忽略",
                "type": "float",
                "default": 1.0
            },
            "do_sample":{
                "description": "是否采样",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "bool",
                "default": true
            },
            "top_p":{
                "description": "采样top_p",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "float",
                "default": 0.8
            },
            "top_k":{
                "description": "采样top_k",
                "hint": "0表示不启用；需后端支持，原版service.py会忽略",
                "type": "int",
                "default": 30
            },
            "temperature":{
                "description": "采样temperature",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "float",
                "default": 0.8
            },
            "repetition_penalty":{
                "description": "重复惩罚",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "float",
                "default": 10.0
            },
            "length_penalty":{
                "description": "长度惩罚",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "float",
                "default": 0.0
            },
            "num_beams":{
                "description": "beam search数量",
                "hint": "需后端支持，原版service.py会忽略",
                "type": "int",
                "default": 3
            },
            "max_mel_tokens":{
                "description": "生成Token最大数量",
                "hint": "过小导致音频截断；需后端支持，原版service.py会忽略",
                "type": "int",
                "default": 1500
            }
        }
    },
    "serve_config":{
        "description": "服务器设置",
        "type": "object",
        "items": {
            "server_ip":{
                "description": "服务器地址",
                "type": "string",
                "hint": "若为本机使用则不需要更改,即127.0.0.1",
                "default": "127.0.0.1"
            },
            "server_port":{
                "description": "服务端口",
                "type": "int",
                "hint": "原版固定5210，本fork可改",
                "default": 5210
            },
            "if_seperate_serve": {
                "description": "是否使用分布式部署",
                "type": "bool",
                "hint": "开启此选项后，本插件就不会自己启动service.py了，且按照服务器地址去访问api",
                "default": false
            },
            "request_timeout": {
                "description": "合成请求超时(秒)",
                "type": "int",
                "hint": "原版硬编码120秒，长文本在消费级显卡上会超时；默认600秒",
                "default": 600
            },
            "CORRECT_API_KEY": {
                "description": "api密钥",
                "type": "string",
                "hint": "自定义的api密钥，用于验证请求",
                "default": "1145141919810"
            }
        }
    }
}